{
  "name": "@ninkch/dsh-infinite-canvas",
  "version": "0.17.3",
  "description": "Node-based short-drama studio for DeepSeek Harness: script → storyboard → assets → shots → voiced, subtitled final cut on an infinite canvas.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "infinite-canvas",
    "storyboard",
    "short-drama",
    "ai-video",
    "image-generation",
    "video-generation",
    "seedance",
    "photocraft",
    "filmcraft"
  ],
  "license": "Apache-2.0",
  "author": "NINKCH",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NINKCH/dsh-infinite_canvas.git"
  },
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.zh-CN.md",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
